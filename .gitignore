.DS_Store
*.pem

# local env files
.env*.local

# Play publishing credential — eas.json points `submit.production.android
# .serviceAccountKeyPath` here, so this file gets created locally at some
# point. It must never be committed.
google-play-service-account.json
*-service-account.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Local build artifacts downloaded from EAS (AAB/APK) — never commit binaries
build-artifacts/
.expo-export-check/

# greenfield UI design previews (Phase 1 sandbox — see CLAUDE.md)
/src/_design-sandbox/
