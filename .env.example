# Copy this file to `.env` and fill in what you need. `.env` is git-ignored.
#
# Everything here is EXPO_PUBLIC_* and therefore bundled into the app. Never
# put real secrets in this file; they belong on the backend.

# Base URL of the amoria-connect API, including /api/remote.
# Unset = production (https://backend.connekyt.com/api/remote).
# Local backend: use your Mac's LAN IP, not localhost, so the phone can reach it.
# `./scripts/set-dev-ip.sh` fills this in for you.
#EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8080/api/remote

# Public web app base URL (registration and paid checkout open here).
#EXPO_PUBLIC_WEB_BASE_URL=https://connekyt.com

# Google OAuth client IDs from Google Cloud Console. Public identifiers, not
# secrets, but keep them out of git so each environment sets its own.
#EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
#EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
