{
  "expo": {
    "name": "Connekyt",
    "slug": "connekt-mobile",
    "version": "2.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "connekt",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d81fbfa6-f576-4450-97c6-c443332179be",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connekyt.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Connekyt uses your camera to record video messages and to broadcast your event live.",
        "NSMicrophoneUsageDescription": "Connekyt uses your microphone to record video messages and live audio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amoria.connekyt.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#083A85"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Connekyt accesses your photos so you can share them.",
          "cameraPermission": "Connekyt uses your camera to record video messages and to broadcast your event live.",
          "microphonePermission": "Connekyt uses your microphone to record video messages and live audio."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Connekyt uses your camera to scan the QR code shown on your TV so it can sign you in."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class expo.modules.kotlin.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn expo.modules.**\n-keep class com.facebook.react.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.horcrux.svg.** { *; }",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d81fbfa6-f576-4450-97c6-c443332179be"
      }
    }
  }
}
