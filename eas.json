{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {                                 
        "EXPO_PUBLIC_API_BASE_URL":            
          "https://backend.connekyt.com/api/remote",   
         "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID":"151339453973-onclu11vd2p1slg9bjj8g8rcc88h3vsr.apps.googleusercontent.com"                       
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://backend.connekyt.com/api/remote",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "151339453973-onclu11vd2p1slg9bjj8g8rcc88h3vsr.apps.googleusercontent.com"
      }
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}