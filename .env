EXPO_PUBLIC_API_BASE_URL=https://backend.connekyt.com/api/remote

# Google OAuth clients. EXPO_PUBLIC_* is baked into the bundle at build time,
# so run `npx expo start -c` after changing these — a plain reload won't do it.
#
# NOTE: the Android client lives in project 151339453973 while the web client
# lives in project 333682430431. They are separate OAuth clients; that works,
# but the redirect URIs / origins have to be configured in the matching project.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=151339453973-onclu11vd2p1slg9bjj8g8rcc88h3vsr.apps.googleusercontent.com

# Same "Web application" client knockout uses. Enables the real Google account
# chooser when the app runs on web (expo start --web) — no dev build needed.
# Requires http://localhost:8081 in that client's Authorized JavaScript origins
# AND Authorized redirect URIs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=333682430431-01fsjcragfiqh5kb0tp3b8hh4e7o9n45.apps.googleusercontent.com

# iOS client not created yet — needed only for a device dev build.
# Create an "iOS" client with bundle ID com.connekyt.app, then set it here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
